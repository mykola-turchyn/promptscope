{
  "name": "@promptscope/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./demo": "./src/demo/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "migrate:prod": "node dist/migrate.js",
    "seed:prod": "node dist/seed.js"
  },
  "dependencies": {
    "@promptscope/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@promptscope/tsconfig": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
